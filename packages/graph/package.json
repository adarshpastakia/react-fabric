{
  "name": "@react-fabric/graph",
  "version": "1.0.0",
  "description": "RUF: SigmaJS link analysis graph",
  "author": "Adarsh Pastakia <adarshpastakia@outlook.com>",
  "license": "MIT",
  "repository": "https://github.com/adarshpastakia/react-fabric/tree/main/packages/graph",
  "source": "src/index.ts",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "directories": {
    "src": "src",
    "styles": "css",
    "test": "tests"
  },
  "files": [
    "css",
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prebuild": "rm -rf ./dist",
    "build:dts": "tsc -p ./tsconfig.build.json",
    "build:rollup": "rollup -c ../../rollup.config.mjs",
    "build": "npm-run-all -p build:rollup build:dts",
    "watch:dts": "tsc -w -p ./tsconfig.build.json",
    "watch:rollup": "rollup -w -c ../../rollup.config.mjs",
    "watch": "npm-run-all -p watch:rollup watch:dts"
  },
  "dependencies": {
    "@floating-ui/react": "~0.27.20",
    "@react-fabric/core": "^1.0.0",
    "@react-fabric/utilities": "^1.0.0",
    "@sigma/layer-webgl": "beta",
    "@sigma/node-border": "beta",
    "@sigma/node-image": "beta",
    "@sigma/node-piechart": "beta",
    "@sigma/utils": "beta",
    "dom-to-image": "~2.6.0",
    "graphology": "~0.26.0",
    "graphology-layout": "~0.6.1",
    "graphology-layout-force": "~0.2.4",
    "graphology-layout-forceatlas2": "~0.10.1",
    "graphology-types": "~0.24.8",
    "sigma": "beta"
  },
  "peerDependencies": {
    "i18next": "~26.3.6",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-i18next": "~17.0.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
