{
  "name": "react-fabric",
  "version": "1.0.0",
  "description": "React UI Framework",
  "author": "Adarsh Pastakia <adarshpastakia@outlook.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "npm run copy:arcgis && jest --ci --runInBand --detectOpenHandles --json --outputFile=./.storybook/jest-test-results.json",
    "storybook": "storybook dev -p 6003",
    "storybook:build": "NODE_OPTIONS=--max-old-space-size=8192 storybook build -o ./build",
    "copy:arcgis": "cp -r ./node_modules/@arcgis/core/assets/ ./assets/@arcgis",
    "lint:css": "stylelint packages/**/*.css",
    "lint:ts": "eslint --no-error-on-unmatched-pattern .",
    "check:ts": "turbo run build:dts",
    "lint": "npm-run-all lint:css lint:ts check:ts",
    "pretest": "npm run lint && tailwindcss -i ./.storybook/styles/styles.css -o ./.storybook/styles/output.css",
    "jest": "jest --ci --runInBand --detectOpenHandles --forceExit --coverage .",
    "test": "npm run jest",
    "dist": "turbo run build",
    "watch": "turbo watch watch",
    "release": "npm version --conventional-commits --yes --preid=beta -m \"chore(release): %v\"",
    "prepare": "husky"
  },
  "dependencies": {
    "i18next": "~26.3.6",
    "i18next-browser-languagedetector": "~8.2.1",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-i18next": "~17.0.11",
    "react-router": "~8.3.0",
    "react-router-dom": "~7.18.2",
    "resize-observer-polyfill": "~1.5.1",
    "tailwindcss": "~4.3.3"
  },
  "devDependencies": {
    "@babel/core": "~7.29.7",
    "@babel/plugin-transform-modules-commonjs": "~7.29.7",
    "@babel/plugin-transform-runtime": "~7.29.7",
    "@babel/preset-env": "~7.29.7",
    "@babel/preset-react": "~7.29.7",
    "@babel/preset-typescript": "~7.29.7",
    "@chromatic-com/storybook": "~5.2.1",
    "@eslint/js": "~10.0.1",
    "@eslint-react/eslint-plugin": "~5.8.12",
    "@faker-js/faker": "~10.4.0",
    "@iconify-json/circle-flags": "~1.2.10",
    "@iconify-json/flag": "~1.2.12",
    "@iconify-json/solar": "~1.2.6",
    "@rollup/plugin-babel": "~7.1.0",
    "@rollup/plugin-commonjs": "~29.0.3",
    "@rollup/plugin-json": "~6.1.0",
    "@rollup/plugin-node-resolve": "~16.0.3",
    "@rollup/plugin-typescript": "~11.1.6",
    "@storybook/addon-a11y": "~10.5.6",
    "@storybook/addon-docs": "~10.5.6",
    "@storybook/addon-vitest": "~10.5.6",
    "@storybook/react-vite": "~10.5.6",
    "@stylistic/eslint-plugin": "~5.10.0",
    "@tailwindcss/cli": "~4.3.3",
    "@tailwindcss/vite": "~4.3.3",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.2",
    "@types/dom-to-image": "~2.6.7",
    "@types/chroma-js": "~3.1.2",
    "@types/jest": "~30.0.0",
    "@types/node": "~22.18.0",
    "@types/react": "~19.2.16",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.2",
    "@vitest/browser-playwright": "~4.1.8",
    "@vitest/coverage-v8": "~4.1.8",
    "eslint": "~10.3.0",
    "eslint-plugin-jsx-a11y-x": "~0.2.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-storybook": "~10.5.6",
    "globals": "~17.6.0",
    "husky": "~9.1.7",
    "jest": "~30.4.2",
    "jest-environment-jsdom": "~30.4.1",
    "jest-transform-css": "~6.0.3",
    "jest-transform-stub": "~2.0.0",
    "jsdom": "~29.1.1",
    "jsdom-global": "~3.0.2",
    "monaco-editor-webpack-plugin": "~7.1.1",
    "msw": "~2.15.0",
    "msw-storybook-addon": "~3.0.0",
    "mutationobserver-shim": "~0.3.7",
    "npm-run-all": "~4.1.5",
    "playwright": "~1.60.0",
    "postcss": "~8.5.25",
    "prettier": "~3.8.3",
    "prop-types": "~15.8.1",
    "rollup": "~4.61.0",
    "rollup-copy-transform-css": "~2.2.0",
    "rollup-plugin-copy": "~3.5.0",
    "rollup-plugin-exclude-dependencies-from-bundle": "~1.1.24",
    "rollup-plugin-import-css": "~4.2.1",
    "rollup-plugin-svg-import": "~3.0.0",
    "rollup-plugin-web-worker-loader": "~1.7.0",
    "storybook": "~10.5.6",
    "stylelint": "~17.12.0",
    "stylelint-config-clean-order": "~10.0.0",
    "stylelint-config-standard": "~40.0.0",
    "stylelint-config-tailwindcss": "~1.0.1",
    "stylelint-order": "~8.1.1",
    "stylelint-selector-bem-pattern": "~5.0.0",
    "ts-jest": "~29.4.11",
    "ts-loader": "~9.6.0",
    "turbo": "~2.10.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.66.0",
    "vite": "~8.2.0",
    "vitest": "~4.1.10"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "msw": {
    "workerDirectory": [
      "static"
    ]
  }
}
